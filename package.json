{
  "name": "fellow-collaboration-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests --dir workers",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:concurrency": "vitest run tests/concurrency",
    "test:realtime": "vitest run tests/realtime",
    "worker:outbox": "tsx workers/outbox/worker.ts",
    "docker:up": "docker compose up --build",
    "test:ui": "node tests/ui/smoke.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "next": "^14.2.35",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
