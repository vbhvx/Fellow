# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/fellow
# Used when NODE_ENV=test (vitest). Must be a separate database: tests write to it.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/fellow_test
# Connections per app instance. Mind your Postgres max_connections x instance count.
DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Required in production, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_key_min_32_characters

# --- Operations -------------------------------------------------------------
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=info
# Set to true only for load tests against non-production environments.
RATE_LIMIT_DISABLED=false
# Outbox worker poll interval
OUTBOX_POLL_INTERVAL_MS=1000

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
